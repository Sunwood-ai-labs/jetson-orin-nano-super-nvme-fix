{
  "name": "jetson-orin-nano-super-nvme-fix",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs --host 127.0.0.1",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs --host 127.0.0.1",
    "check:shell": "bash -n scripts/*.sh llm-experiment/*.sh",
